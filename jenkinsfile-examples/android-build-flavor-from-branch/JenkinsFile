pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        // Checkout code from repository and update any submodules.
        checkout scm
        sh 'git submodule update --init'
      }
    }

    stage('Build') {
      steps {
        script {
          echo "My branch is: ${env.BRANCH_NAME}"
          env.FLAVOR = getFlavor(env.BRANCH_NAME)
          echo "Building flavor ${env.FLAVOR}"
        }

        // Build the selected flavor and pass the build number to Gradle.
        sh "./gradlew clean assemble${env.FLAVOR}Debug -PBUILD_NUMBER=${env.BUILD_NUMBER}"
      }
    }

    stage('Archive') {
      steps {
        archiveArtifacts artifacts: 'app/build/outputs/apk/*.apk', fingerprint: true
      }
    }

    stage('Upload To Fabric') {
      steps {
        sh "./gradlew crashlyticsUploadDistribution${env.FLAVOR}Debug -PBUILD_NUMBER=${env.BUILD_NUMBER}"
      }
    }
  }
}

// Pulls the Android flavor from branch names prefixed with QA_.
def getFlavor(String branchName) {
  def matcher = (branchName =~ /QA_([a-z_]+)/)
  if (!matcher.matches()) {
    error("Branch '${branchName}' does not match required format 'QA_<flavor>'")
  }
  return matcher[0][1]
}
